{
  "permissions": {
    "allow": [
      "Read(./**)",
      "Read(~/.claude/**)",
      "Read(~/AppData/Local/Temp/claude/**)",
      "Read(/tmp/claude/**)",
      "Edit(./**)",
      "Write(./**)",
      "Read(./scratchpad/**)",
      "Edit(./scratchpad/**)",
      "Write(./scratchpad/**)",
      "Edit(~/AppData/Local/Temp/claude/**)",
      "Write(~/AppData/Local/Temp/claude/**)",
      "Edit(/tmp/claude/**)",
      "Write(/tmp/claude/**)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(py *)",
      "Bash(jupyter *)",
      "Bash(sqlcmd *)",
      "PowerShell(python *)",
      "PowerShell(py *)",
      "PowerShell(jupyter *)",
      "PowerShell(sqlcmd *)"
    ],
    "ask": [
      "Write(./.claude/**)",
      "Edit(./.claude/**)",
      "Write(./CLAUDE.md)",
      "Edit(./CLAUDE.md)"
    ],
    "deny": [
      "Write(./data/**)",
      "Edit(./data/**)",
      "Write(./audit/**)",
      "Edit(./audit/**)",
      "Read(~/.dme-secrets/**)",
      "Read(**/.dme-secrets/**)",
      "Read(**/*.env)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/.credentials.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/audit_log.py\"" }
        ]
      }
    ]
  }
}
