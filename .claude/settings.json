{
  "permissions": {
    "allow": [
      "Read(./**)",
      "Read(~/.claude/**)",
      "Read(~/AppData/Local/Temp/claude/**)",
      "Read(/tmp/claude/**)",
      "Edit(./**)",
      "Write(./**)",
      "Read(./scratchpad/**)",
      "Edit(./scratchpad/**)",
      "Write(./scratchpad/**)",
      "Edit(~/AppData/Local/Temp/claude/**)",
      "Write(~/AppData/Local/Temp/claude/**)",
      "Edit(/tmp/claude/**)",
      "Write(/tmp/claude/**)",
      "Read(//c/Users/aenew/Documents/productivity-agent/**)",
      "Read(//c/Users/aenew/AppData/Local/Temp/claude/**)",
      "Edit(//c/Users/aenew/AppData/Local/Temp/claude/**)",
      "Write(//c/Users/aenew/AppData/Local/Temp/claude/**)",
      "Read(//c/Users/aenew/.claude/projects/**)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(py *)",
      "Bash(jupyter *)",
      "Bash(sqlcmd *)",
      "Bash(ls *)",
      "Bash(cd *)",
      "Bash(pwd)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(diff *)",
      "Bash(sed -n *)",
      "Bash(awk *)",
      "Bash(find *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(which *)",
      "Bash(where *)",
      "PowerShell(python *)",
      "PowerShell(py *)",
      "PowerShell(jupyter *)",
      "PowerShell(sqlcmd *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Item *)"
    ],
    "ask": [
      "Write(./.claude/**)",
      "Edit(./.claude/**)",
      "Write(./CLAUDE.md)",
      "Edit(./CLAUDE.md)"
    ],
    "deny": [
      "Write(./data/**)",
      "Edit(./data/**)",
      "Write(./audit/**)",
      "Edit(./audit/**)",
      "Read(~/.dme-secrets/**)",
      "Read(**/.dme-secrets/**)",
      "Read(**/*.env)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/.credentials.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/audit_log.py\"" }
        ]
      }
    ]
  }
}
